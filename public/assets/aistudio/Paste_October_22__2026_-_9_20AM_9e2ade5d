✅ شرح الحل:
تعامل مع كل استدعاء بشكل صريح وارجع نتيجة واضحة { ok, error } للواجهة، وعرض رسالة للمسؤول بناءً عليها.

✅ الكود المصحح:

typescript
export async function saveUserToCloud(user: User): Promise<{ ok: boolean; error?: string }> {
  try {
    const { error: usersErr } = await supabase
      .from('users')
      .upsert({
        id: user.id,
        civil_id: normalizeCivilId(user.civilId) || null,
        name: user.name.trim(),
        role: user.role,
        user_type: user.userType || 'employee',
        work_entity: user.workEntity,
        job_title: user.jobTitle,
        phone: user.phone ? normalizePhone(user.phone) : null,
        status: user.status,
        permissions: user.permissions,
      }, { onConflict: 'id' });

    if (usersErr) {
      console.error('users upsert failed:', usersErr);
      return { ok: false, error: usersErr.message };
    }

    return { ok: true };
  } catch (err: any) {
    console.error('Cloud save exception:', err);
    return { ok: false, error: err?.message || 'خطأ غير معروف' };
  }
}

