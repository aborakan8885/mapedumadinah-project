✅ شرح الحل:
استبدله بمكوّن Leaflet حقيقي (مثل الكود الأصلي في الملف السابق)، أو أعد تسميته إلى SchoolsList لتجنّب التضليل.

✅ الكود المصحح (يستخدم Leaflet):

typescript
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';

export function SchoolsMapView({
  schools, selectedSchool, onSelectSchool, canViewCoordinates,
}: {
  schools: EducationalPlace[];
  selectedSchool: EducationalPlace | null;
  onSelectSchool: (s: EducationalPlace) => void;
  canViewCoordinates: boolean;
}) {
  const containerRef = useRef<HTMLDivElement>(null);
  const mapRef = useRef<L.Map | null>(null);
  const markersRef = useRef<L.LayerGroup | null>(null);

  useEffect(() => {
    if (!containerRef.current || mapRef.current) return;
    const map = L.map(containerRef.current, { center: [24.4672, 39.6111], zoom: 11 });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
    markersRef.current = L.layerGroup().addTo(map);
    mapRef.current = map;
    return () => { map.remove(); mapRef.current = null; };
  }, []);

  useEffect(() => {
    if (!markersRef.current) return;
    markersRef.current.clearLayers();
    schools.forEach((s) => {
      if (!canViewCoordinates) return; // ⚠️ حجب كامل للمستفيد
      const marker = L.marker([s.lat, s.lng]).bindPopup(s.name);
      marker.on('click', () => onSelectSchool(s));
      markersRef.current!.addLayer(marker);
    });
  }, [schools, canViewCoordinates, onSelectSchool]);

  return <div ref={containerRef} className="w-full h-full" />;
}
