// Supabase Edge Function: get-schools
export default async function getSchools(req: Request) {
  const authHeader = req.headers.get('Authorization');
  if (!authHeader) return new Response('Unauthorized', { status: 401 });

  const { data: userData } = await supabase.auth.getUser(authHeader.replace('Bearer ', ''));
  const canViewCoords = userData?.user?.user_metadata?.permissions?.canViewCoordinates === true;

  const { data: schools } = await supabase.from('schools').select('*');

  const sanitized = (schools || []).map((s) => ({
    ...s,
    lat: canViewCoords ? s.lat : null,
    lng: canViewCoords ? s.lng : null,
  }));

  return Response.json(sanitized);
}
