    const matchLevel = selectedLevel === 'all' || s.level === selectedLevel;
    const matchGender = selectedGender === 'all' || s.gender === selectedGender;
    const matchDistrict = selectedDistrict === 'all' || s.district === selectedDistrict;
    return matchSearch && matchLevel && matchGender && matchDistrict;
  });
