typescript
export async function saveUserToCloud(user: User): Promise<{ ok: boolean; error?: string }> {
  try {
    if (user.password && user.password.length > 0) {
      // استدعاء Edge Function مسؤولة عن تجزئة كلمة المرور
      const { error: pwErr } = await supabase.functions.invoke('set-user-password', {
        body: { user_id: user.id, new_password: user.password },
      });
      if (pwErr) throw pwErr;
    }

    const { error } = await supabase.from('users').upsert(
      {
        id: user.id,
        civil_id: normalizeCivilId(user.civilId) || null,
        name: user.name.trim(),
        role: user.role,
        user_type: user.userType || 'employee',
        work_entity: user.workEntity,
        job_title: user.jobTitle,
        phone: user.phone ? normalizePhone(user.phone) : null,
        status: user.status,
        permissions: {
          visibleLayers: user.permissions.visibleLayers,
          canViewCoordinates: user.permissions.canViewCoordinates,
          canExportReports: user.permissions.canExportReports,
          canUseSurroundingAnalysis: user.permissions.canUseSurroundingAnalysis,
        },
      },
      { onConflict: 'id' }
    );
    if (error) throw error;
    return { ok: true };
  } catch (err: any) {
    console.error('Save to cloud failed:', err);
    return { ok: false, error: err?.message || 'خطأ غير معروف' };
  }
}
