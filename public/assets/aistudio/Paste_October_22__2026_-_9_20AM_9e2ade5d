❌ المشكلة رقم 8: استنفاذ المستخدمين (User Enumeration)
📌 المشكلة:
رسائل الخطأ مختلفة بحسب الحالة، ما يكشف للمهاجم: هل الرقم مسجل؟ هل الحساب معطل؟ هذا يسمح بجمع قائمة أرقام السجلات المسجلة قبل الهجوم، وأيضاً يسمح بهجوم Timing Attack (زمن الاستجابة يختلف بحسب الحالة).

🔴 الكود الخطأ:

typescript
if (!user) { setError('❌ هذا السجل المدني غير مضاف في قائمة المعتمدين...'); return; }
if (user.status === 'disabled') { setError('⚠️ الحساب معطل حالياً...'); return; }
if (user.password !== pwdClean) { setError('كلمة المرور غير صحيحة...'); return; }
✅ شرح الحل:
استخدم رسالة موحدة لكل حالات الفشل، وأضف تأخيراً زمنياً ثابتاً (مثلاً 800ms) لأي محاولة دخول فاشلة لمنع Timing Attack.

✅ الكود المصحح:

typescript
const GENERIC_ERROR = 'بيانات الدخول غير صحيحة.';
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

const handleEmployeeLogin = async (e: React.FormEvent) => {
  e.preventDefault();
  setError('');
  const idClean = normalizeCivilId(civilIdLogin);
  const pwdClean = passwordLogin.trim();
  if (!idClean || !pwdClean) { setError('...'); return; }

  setIsSubmitting(true);
  try {
    const start = Date.now();
    const user = await lookupUserByCivilId(idClean);

    let ok = false;
    if (user && user.status === 'active' && user.password) {
      ok = await verifyPassword(pwdClean, user.password);
    }

    const elapsed = Date.now() - start;
    if (elapsed < 800) await sleep(800 - elapsed);

    if (!ok) { setError(GENERIC_ERROR); return; }
    onLoginSuccess(user!);
  } finally {
    setIsSubmitting(false);
  }
};
