✅ شرح الحل:
احذف من جميع الأماكن: users + system_users_backup + localStorage. ثم تحقق من نجاح كل خطوة قبل الانتقال للتالية.

✅ الكود المصحح:

typescript
const handleDeleteUser = async (targetId: string) => {
  if (!window.confirm('هل أنت متأكد من حذف هذا المستخدم نهائياً من النظام والسحابة؟')) return;

  const target = users.find((u) => u.id === targetId);

  // 1) احذف من القائمة المحلية فوراً
  const filtered = users.filter((u) => u.id !== targetId);
  saveLocalUsers(filtered);
  setUsers(filtered);

  try {
    // 2) احذف من جدول users
    await supabase.from('users').delete().eq('id', targetId);

    // 3) احذف من جدول النسخ الاحتياطي
    const { data: backup } = await supabase
      .from('educational_files')
      .select('data')
      .eq('id', 'system_users_backup')
      .maybeSingle();

    if (backup && Array.isArray(backup.data)) {
      const targetCivilId = normalizeCivilId(target?.civilId);
      const newBackup = backup.data.filter(
        (b: any) => b.id !== targetId && normalizeCivilId(b.civil_id) !== targetCivilId
      );
      await supabase
        .from('educational_files')
        .upsert({ id: 'system_users_backup', data: newBackup }, { onConflict: 'id' });
    }

    setSyncMessage('✅ تم حذف المستخدم نهائياً من جميع الجداول.');
    setTimeout(() => setSyncMessage(null), 4000);
  } catch (err) {
    console.error('Delete failed:', err);
    setSyncMessage('⚠️ فشل الحذف من السحابة. يرجى إعادة المحاولة.');
  }
};
