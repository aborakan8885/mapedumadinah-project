❌ المشكلة رقم 3: كلمات المرور مخزّنة كنص صريح في localStorage
📌 المشكلة:
saveLocalUsers تخزّن المستخدمين كاملين — بما فيهم كلمة المرور — في localStorage. أي ثغرة XSS بسيطة تستطيع سرقة جميع كلمات المرور (بما فيها كلمة المسؤول) عبر localStorage.getItem('educational_map_users').

🔴 الكود الخطأ:

typescript
export function saveLocalUsers(users: User[]) {
  try {
    localStorage.setItem(MOCK_USERS_KEY, JSON.stringify(users)); // ⚠️ يحفظ كلمة المرور
  } catch (e) {
    console.error('Local save error', e);
  }
}

export function getLocalUsers(): User[] {
  try {
    const raw = localStorage.getItem(MOCK_USERS_KEY);
    if (!raw) {
      localStorage.setItem(MOCK_USERS_KEY, JSON.stringify(INITIAL_SYSTEM_USERS));
      return INITIAL_SYSTEM_USERS;
    }
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) && parsed.length > 0 ? parsed : INITIAL_SYSTEM_USERS;
  } catch {
    return INITIAL_SYSTEM_USERS;
  }
}
✅ شرح الحل:
افصل كائن المستخدم عن بيانات الاعتماد. احفظ فقط { id, name, role, permissions } (Session Payload آمن) في localStorage، ولا تحفظ password أبداً. أضف CSP صارم لتقليل احتمال XSS أصلاً.

✅ الكود المصحح:

typescript
type SafeUser = Omit<User, 'password'>;

export function saveLocalUsers(users: SafeUser[]) {
  try {
    const safe = users.map(({ password, ...rest }) => rest);
    localStorage.setItem(MOCK_USERS_KEY, JSON.stringify(safe));
  } catch (e) {
    console.error('Local save error', e);
  }
}

export function getLocalUsers(): SafeUser[] {
  try {
    const raw = localStorage.getItem(MOCK_USERS_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    // تنظيف أي كلمات مرور قديمة تسرّبت سابقاً
    return parsed.map(({ password, ...rest }: any) => rest);
  } catch {
    return [];
  }
}
